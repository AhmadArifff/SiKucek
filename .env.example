# ==============================================================================
# SiKucek (Smart Hybrid Laundry Operating System) - Environment Variables
# ==============================================================================
# Salin file ini menjadi .env.local di apps/web dan apps/pos jika ingin
# menghubungkan proyek database Supabase dan Midtrans secara live.
#
# JIKA KOSONG / BELUM DIISI:
# Sistem otomatis berjalan dalam MODE MANDIRI (ZERO INFRASTRUCTURE COST / Rp 0)
# dengan graceful in-memory mock store lokal untuk kebutuhan demo & development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Storage (Zero Cost Tier Gratisan)
# Dapatkan dari: https://supabase.com -> Project Settings -> API & Database
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://nvnuezmzbtcgpzqulwbw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection Strings (Port 6543 = Pooler, Port 5432 = Direct/Session)
DATABASE_URL=postgresql://postgres.nvnuezmzbtcgpzqulwbw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.nvnuezmzbtcgpzqulwbw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 2. Midtrans Payment Gateway (QRIS & Virtual Account)
# Dapatkan dari: https://dashboard.midtrans.com -> Settings -> Access Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-sandbox-client-key
MIDTRANS_SERVER_KEY=SB-Mid-server-your-sandbox-server-key
MIDTRANS_MERCHANT_ID=G12345678
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 3. Port Konfigurasi Monorepo
# ------------------------------------------------------------------------------
PORT_WEB=3000
PORT_POS=3001
PORT_WORKER=4000
